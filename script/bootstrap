#!/usr/bin/env bash

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/env"
cd "$DIR"

require_file() {
  if [ ! -f "$1" ]; then
    echo "required vendored file is missing: ${1#$DIR/}" >&2
    echo "run script/vendor to refresh committed dependency artifacts" >&2
    exit 1
  fi
}

current_python_version="$($BOOTSTRAP_PYTHON_BIN -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
if [ "$current_python_version" != "$PROJECT_PYTHON_VERSION" ]; then
  echo "python $PROJECT_PYTHON_VERSION is required, found $current_python_version" >&2
  exit 1
fi

require_file "$DIR/uv.lock"
require_file "$VENDOR_REQUIREMENTS"
require_file "$VENDOR_RUNTIME_REQUIREMENTS"
require_file "$VENDOR_BOOTSTRAP_REQUIREMENTS"
if ! find "$VENDOR_CACHE_DIR" -maxdepth 1 -type f -name '*.whl' -print -quit 2>/dev/null | grep -q .; then
  echo "vendored wheels are missing for $VENDOR_PLATFORM" >&2
  exit 1
fi

if ! run_uv --version 2>/dev/null | grep -Eq "^uv ${UV_BOOTSTRAP_VERSION}( |$)"; then
  rm -rf "$BOOTSTRAP_TOOLS_DIR"
  mkdir -p "$BOOTSTRAP_TOOLS_DIR"
  "$BOOTSTRAP_PYTHON_BIN" -m pip install \
    --disable-pip-version-check \
    --require-hashes \
    --no-index \
    --find-links "$VENDOR_CACHE_DIR" \
    --target "$BOOTSTRAP_TOOLS_DIR" \
    -r "$VENDOR_BOOTSTRAP_REQUIREMENTS"
fi

recreate_venv="false"
if [ ! -x "$VENV_DIR/bin/python" ]; then
  recreate_venv="true"
elif [ "$("$VENV_DIR/bin/python" -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')" != "$PROJECT_PYTHON_VERSION" ]; then
  recreate_venv="true"
fi

if [ "$recreate_venv" = "true" ]; then
  rm -rf "$VENV_DIR"
  run_uv venv --python "$BOOTSTRAP_PYTHON_BIN" "$VENV_DIR"
fi

run_uv pip sync \
  --python "$VENV_DIR/bin/python" \
  --require-hashes \
  --no-index \
  --find-links "$VENDOR_CACHE_DIR" \
  "$VENDOR_REQUIREMENTS"
run_uv lock --check --offline
run_uv pip check --python "$VENV_DIR/bin/python"

echo -e "${GREEN}Bootstrap complete for ${PURPLE}${VENDOR_PLATFORM}${OFF}"
