#!/usr/bin/env bash

set -euo pipefail

upgrade_args=()
if [ "${1:-}" = "--upgrade" ] || [ "${1:-}" = "-U" ]; then
  upgrade_args=(--upgrade)
  shift
fi
if [ "$#" -ne 0 ]; then
  echo "usage: script/vendor [--upgrade|-U]" >&2
  exit 2
fi

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HERE/env"
cd "$DIR"
unset UV_OFFLINE PIP_NO_INDEX

current_python_version="$($BOOTSTRAP_PYTHON_BIN -c 'import sys; print(".".join(map(str, sys.version_info[:3])))')"
if [ "$current_python_version" != "$PROJECT_PYTHON_VERSION" ]; then
  echo "python $PROJECT_PYTHON_VERSION is required, found $current_python_version" >&2
  exit 1
fi

network_pip() {
  if command -v sfw >/dev/null 2>&1; then
    sfw pip "$@"
  else
    "$BOOTSTRAP_PYTHON_BIN" -m pip "$@"
  fi
}

"$BOOTSTRAP_PYTHON_BIN" - "$UV_BOOTSTRAP_VERSION" "$VENDOR_BOOTSTRAP_REQUIREMENTS" <<'PYTHON'
import json
import sys
import urllib.request
from pathlib import Path

version, output_path = sys.argv[1:]
with urllib.request.urlopen(f"https://pypi.org/pypi/uv/{version}/json", timeout=30) as response:
    release = json.load(response)

required_suffixes = (
    "macosx_11_0_arm64.whl",
    "manylinux_2_17_x86_64.manylinux2014_x86_64.whl",
)
hashes = {
    item["filename"]: item["digests"]["sha256"]
    for item in release["urls"]
    if item["filename"].endswith(required_suffixes)
}
if len(hashes) != len(required_suffixes):
    raise SystemExit(f"expected {len(required_suffixes)} supported uv wheels, found {len(hashes)}")

lines = [
    "# This file is generated by script/vendor from the exact PyPI release metadata.",
    f"uv=={version} \\",
]
for index, digest in enumerate(sorted(hashes.values())):
    suffix = " \\" if index < len(hashes) - 1 else ""
    lines.append(f"    --hash=sha256:{digest}{suffix}")
Path(output_path).write_text("\n".join(lines) + "\n")
PYTHON

if ! run_uv --version 2>/dev/null | grep -Eq "^uv ${UV_BOOTSTRAP_VERSION}( |$)"; then
  rm -rf "$BOOTSTRAP_TOOLS_DIR"
  mkdir -p "$BOOTSTRAP_TOOLS_DIR"
  network_pip install \
    --disable-pip-version-check \
    --require-hashes \
    --target "$BOOTSTRAP_TOOLS_DIR" \
    -r "$VENDOR_BOOTSTRAP_REQUIREMENTS"
fi

network_uv() {
  if command -v sfw >/dev/null 2>&1; then
    PYTHONPATH="$BOOTSTRAP_TOOLS_DIR${PYTHONPATH:+:$PYTHONPATH}" sfw "$BOOTSTRAP_PYTHON_BIN" -m uv "$@"
  else
    run_uv "$@"
  fi
}

if ((${#upgrade_args[@]})); then
  network_uv lock "${upgrade_args[@]}"
else
  network_uv lock
fi
network_uv export --frozen --all-groups --no-emit-project --format requirements.txt --output-file vendor/requirements.lock.txt
network_uv export --frozen --no-dev --no-emit-project --format requirements.txt --output-file vendor/runtime-requirements.lock.txt

rm -rf "$VENDOR_DIR/cache/python"
mkdir -p "$VENDOR_DIR/cache/python/macos-arm64" "$VENDOR_DIR/cache/python/linux-x86_64"

download_platform() {
  local destination="$1"
  local platform="$2"
  local requirements
  for requirements in "$VENDOR_REQUIREMENTS" "$VENDOR_BOOTSTRAP_REQUIREMENTS"; do
    network_pip download \
      --disable-pip-version-check \
      --require-hashes \
      --dest "$destination" \
      --only-binary=:all: \
      --platform "$platform" \
      --python-version 3.14 \
      --implementation cp \
      --abi cp314 \
      -r "$requirements"
  done
}

download_platform "$VENDOR_DIR/cache/python/macos-arm64" macosx_11_0_arm64
download_platform "$VENDOR_DIR/cache/python/linux-x86_64" manylinux2014_x86_64

echo -e "${GREEN}Vendored dependency locks and wheels are current.${OFF}"
